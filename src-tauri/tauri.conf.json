{
  "productName": "Particle-Mineradio",
  "version": "0.1.0",
  "identifier": "com.tauri-app.Particle-Mineradio",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1421",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Particle-Mineradio",
        "width": 1000,
        "height": 600,
        "minWidth": 1000,
        "minHeight": 600,
        "decorations": false,
        "center": true,
        "shadow": false,
        "transparent": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installerIcon": "icons/icon.ico",
        "languages": ["SimpChinese"],
        "displayLanguageSelector": false,
        "startMenuFolder": "Particle-Mineradio"
      },
      "wix": {
        "language": "zh-CN"
      }
    }
  }
}
