{
  "productName": "mineradio",
  "version": "0.1.0",
  "identifier": "com.tauri-app.mineradio",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Mineradio",
        "width": 1000,
        "height": 600,
        "minWidth": 1000,
        "minHeight": 600,
        "decorations": false,
        "center": true,
        "shadow": false,
        "transparent": true,
        "additionalBrowserArgs": "--enable-gpu --ignore-gpu-blocklist --enable-accelerated-video-decode"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
